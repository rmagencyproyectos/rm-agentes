<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chequeo de cobertura de programación: lunes y jueves a las 00:30 (madrugada).
  Corre infra/metricool/chequeo.sh, que consulta Metricool y avisa por WhatsApp (Winy).
  Instalar:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rmagency.cobertura.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rmagency.cobertura</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gerardruizmiro/rmagency/AGENTES RM/infra/metricool/chequeo.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>0</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>0</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/gerardruizmiro/rmagency/AGENTES RM/infra/metricool/cobertura.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gerardruizmiro/rmagency/AGENTES RM/infra/metricool/cobertura.err.log</string>
</dict>
</plist>
