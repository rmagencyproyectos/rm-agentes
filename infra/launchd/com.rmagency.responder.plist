<?xml version="1.0" encoding="UTF-8"?>
<!--
  Servidor de Winy conversacional (WhatsApp entrante → ejecuta tareas). Se auto-arranca
  al iniciar sesión y se reinicia solo si se cae (KeepAlive).

  Instalación (con tu usuario, NO root, para heredar el login de Claude):
    cp com.rmagency.responder.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.rmagency.responder.plist
  Parar:  launchctl unload ~/Library/LaunchAgents/com.rmagency.responder.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rmagency.responder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gerardruizmiro/rmagency/AGENTES RM/infra/responder/run.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/gerardruizmiro/rmagency/AGENTES RM/infra/responder/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gerardruizmiro/rmagency/AGENTES RM/infra/responder/server.err.log</string>
</dict>
</plist>
