# Copia este archivo a `.env` (que está gitignored) y rellena valores reales.
# Genera secretos con: openssl rand -hex 24

# API key para autenticar contra Evolution API (cabecera `apikey`).
AUTHENTICATION_API_KEY=CAMBIAME_api_key_larga_y_aleatoria

# Password de Postgres.
POSTGRES_PASSWORD=CAMBIAME_password_postgres

# --- Notificador (WhatsApp a ti mismo) ---
# Nombre de la instancia que crearás en Evolution.
WA_INSTANCE=rmagency
# Tu número en formato internacional sin '+' ni espacios, con sufijo de WhatsApp.
# Ejemplo España: 34XXXXXXXXX@s.whatsapp.net
WA_DESTINO=34XXXXXXXXX@s.whatsapp.net

# --- Fallback email (SMTP real; se activa cuando WhatsApp está caído) ---
# Destinatario del aviso.
EMAIL_DESTINO=rmagency.proyectos@gmail.com
# Para que el email se envíe de verdad (headless, sin agente): usuario SMTP + App Password.
# Gmail: activa 2FA y crea una "Contraseña de aplicación" de 16 caracteres (NO tu contraseña
# normal) en https://myaccount.google.com/apppasswords . Si dejas estos en blanco, la cascada
# simplemente cae al push (macOS/ntfy) — no rompe nada.
SMTP_USER=rmagency.proyectos@gmail.com
SMTP_PASS=CAMBIAME_app_password_16_chars
# Opcionales (valores por defecto = Gmail SSL):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Fallback push al móvil (opcional) ---
# Si defines un topic, notify.sh manda un push a la app ntfy (https://ntfy.sh): instala la app,
# suscríbete a este mismo topic (elige uno largo y difícil de adivinar). Sin esto, el push usa
# solo la notificación local de macOS.
# NTFY_TOPIC=rm-agency-avisos-CAMBIAME-algo-secreto
